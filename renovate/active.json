{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Dependency policy for active teo-garcia template repositories",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "timezone": "America/Bogota",
  "schedule": ["* 0-5 * * 1"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 3,
  "branchConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "platformAutomerge": false,
  "major": {
    "dependencyDashboardApproval": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["security"],
    "automerge": true,
    "groupName": "security fixes"
  },
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": ["gomodTidy"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the pinned golangci-lint declared in Makefiles",
      "managerFilePatterns": ["/(^|/)Makefile$/"],
      "matchStrings": [
        "GOLANGCI_LINT_VERSION\\s*\\?=\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "github.com/golangci/golangci-lint/v2",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Track the pinned govulncheck declared in Makefiles",
      "managerFilePatterns": ["/(^|/)Makefile$/"],
      "matchStrings": [
        "GOVULNCHECK_VERSION\\s*\\?=\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "golang.org/x/vuln",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Track dependencies annotated in GitHub workflow environment variables",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?:[A-Z0-9_]+_VERSION): [\\\"](?<currentValue>[^\\\"]+)[\\\"]"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group routine non-major updates while keeping shared configuration releases separate",
      "groupName": "routine dependencies",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "!@teo-garcia/**",
        "!/^teo-(ruff|mypy|pytest)-config-shared$/",
        "!github.com/teo-garcia/**"
      ]
    },
    {
      "description": "Merge patch updates automatically once every required check passes; a group merges only when all of its updates are patches",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Review container base image minor upgrades as runtime migrations",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor"],
      "groupName": "container runtime images",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Review Python interpreter minor upgrades as runtime migrations",
      "matchPackageNames": ["python"],
      "matchUpdateTypes": ["minor", "major"],
      "groupName": "Python runtime",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Propose Go toolchain updates in applications; shared Go tooling keeps its declared consumer minimum",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang", "toolchain"],
      "matchRepositories": ["!/-config-shared$/"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Offer Go toolchain patches separately so a pending minor upgrade never holds back a security patch",
      "matchPackageNames": ["go", "golang"],
      "separateMinorPatch": true
    },
    {
      "description": "Keep the go directive and Go images aligned and merge toolchain patches automatically",
      "matchPackageNames": ["go", "golang"],
      "matchUpdateTypes": ["patch"],
      "groupName": "Go runtime patch",
      "automerge": true
    },
    {
      "description": "Review Go minor upgrades as runtime migrations",
      "matchPackageNames": ["go", "golang"],
      "matchUpdateTypes": ["minor", "major"],
      "groupName": "Go runtime",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep shared configuration releases in their own group; each release is verified in real consumers before it is tagged",
      "groupName": "teo-garcia shared configs",
      "matchPackageNames": [
        "@teo-garcia/**",
        "/^teo-(ruff|mypy|pytest)-config-shared$/",
        "github.com/teo-garcia/**"
      ],
      "reviewers": ["teo-garcia"]
    }
  ]
}
