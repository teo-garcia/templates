{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Dependency policy for active teo-garcia template repositories",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "timezone": "America/Bogota",
  "schedule": ["* 0-5 * * 1"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 3,
  "branchConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "platformAutomerge": false,
  "major": {
    "dependencyDashboardApproval": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["security"],
    "automerge": false,
    "groupName": null
  },
  "osvVulnerabilityAlerts": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the pinned golangci-lint declared in Makefiles",
      "managerFilePatterns": ["/(^|/)Makefile$/"],
      "matchStrings": [
        "GOLANGCI_LINT_VERSION\\s*\\?=\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "github.com/golangci/golangci-lint/v2",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Track the pinned govulncheck declared in Makefiles",
      "managerFilePatterns": ["/(^|/)Makefile$/"],
      "matchStrings": [
        "GOVULNCHECK_VERSION\\s*\\?=\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "golang.org/x/vuln",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Track dependencies annotated in GitHub workflow environment variables",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?:[A-Z0-9_]+_VERSION): [\\\"](?<currentValue>[^\\\"]+)[\\\"]"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group routine non-major updates while keeping shared configuration releases separate",
      "groupName": "routine dependencies",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "!@teo-garcia/**",
        "!/^teo-(ruff|mypy|pytest)-config-shared$/",
        "!github.com/teo-garcia/**"
      ]
    },
    {
      "description": "Review shared configuration releases after their producer checks pass",
      "groupName": "teo-garcia shared configs",
      "matchPackageNames": [
        "@teo-garcia/**",
        "/^teo-(ruff|mypy|pytest)-config-shared$/",
        "github.com/teo-garcia/**"
      ],
      "dependencyDashboardApproval": true,
      "reviewers": ["teo-garcia"]
    }
  ]
}
